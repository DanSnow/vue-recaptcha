{
  "name": "vue-recaptcha",
  "version": "3.0.0-alpha.6",
  "description": "ReCAPTCHA vue component",
  "author": "DanSnow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanSnow/vue-recaptcha.git"
  },
  "bugs": {
    "url": "https://github.com/DanSnow/vue-recaptcha/issues"
  },
  "keywords": [
    "vue",
    "component",
    "vue-component",
    "google-recaptcha",
    "google-recaptcha-v3",
    "recaptcha",
    "recaptcha-v3",
    "gcaptcha",
    "captcha",
    "nuxt",
    "nuxt3",
    "nuxt-3"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./unhead": {
      "types": "./dist/unhead.d.ts",
      "import": "./dist/unhead.mjs",
      "require": "./dist/unhead.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.mjs",
      "require": "./dist/nuxt.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "postpublish": "pinst --enable",
    "postinstall": "unbuild",
    "prepack": "yarn build",
    "prepare": "husky install",
    "prepublishOnly": "pinst --disable"
  },
  "workspaces": [
    ".",
    "docs"
  ],
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "^3.9.1",
    "@nuxt/schema": "^3.9.1",
    "@vueuse/shared": "^10.7.2",
    "defu": "^6.1.4",
    "p-defer": "^4.0.1",
    "std-env": "^3.9.0",
    "type-fest": "^4.41.0",
    "vue-demi": "^0.14.10"
  },
  "devDependencies": {
    "@antfu/eslint-config": "6.0.0",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/vue": "8.1.0",
    "@unhead/vue": "1.11.20",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/compiler-dom": "3.5.22",
    "@vue/composition-api": "1.7.2",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.38.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "happy-dom": "20.0.5",
    "husky": "9.1.7",
    "lint-staged": "16.2.4",
    "nuxi": "3.29.3",
    "pinst": "3.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "unbuild": "3.6.1",
    "vite": "7.1.11",
    "vitest": "3.2.4",
    "vue": "3.5.22",
    "vue-sfc-transformer": "0.1.17",
    "vue-tsc": "3.1.1"
  }
}
